NEXT_PUBLIC_DOMAIN=mydomain.com
NEXT_PUBLIC_PROTOCOL=https
NEXT_PUBLIC_SEARCHABLE=false

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=mysecretkey

DATABASE_URL="postgresql://postgres:pass@localhost:5432/myapp?schema=public"

USE_SMTP=false
SMTP_HOST=smtp.server.com
SMTP_PORT=465
SMTP_USER=username
SMTP_PASSWORD=mypassword
EMAIL_FROM=username@server.com

DEBUG=send_email

# Optional — leave empty to disable Upstash rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — leave empty to send email synchronously (skip QStash)
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
