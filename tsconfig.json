{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/entities/*": ["./src/entities/*"],
      "@/hooks": ["./src/shared/hooks"],
      "@/providers": ["./src/shared/providers"],
      "@/server/*": ["./src/server/*"],
      "@/primitives/*": ["./src/shared/primitives/*"],
      "@/utils": ["./src/shared/utils"],
      "@/lib": ["./src/shared/lib"],
      "@/lib/*": ["./src/shared/lib/*"],
      "@/styles/*": ["./src/shared/styles/*"],
      "@/svg/*": ["./src/shared/svg/*"],
      "@/types/*": ["./src/shared/types/*"],
      "@/ui/*": ["./src/shared/ui/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.mjs",
    "eslint/**/*.mjs",
    "postcss.config.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".eloqnt/config.ts"
  ],
  "exclude": ["node_modules"]
}
