{
  "name": "better-auth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint && npx drizzle-kit migrate && next build",
    "start": "next start",
    "lint": "npm run lint:messages && npm run lint:js && npm run lint:style",
    "lint:messages": "npx eloqnt lint",
    "lint:js": "eslint . --ext .jsx,.js,.tsx,.ts",
    "lint:js:timing": "cross-env TIMING=1 npm run lint:js",
    "lint:style": "npx stylelint \"**/*.scss\" --allow-empty-input",
    "knip": "knip",
    "format": "npx eslint --fix && npx prettier --write .",
    "check-types": "tsc --noEmit",
    "drizzle:generate": "npx drizzle-kit generate",
    "drizzle:migrate": "npx drizzle-kit migrate",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "email:dev": "email dev --dir src/shared/lib/email/templates --port 3001"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@better-auth/i18n": "1.7.2",
    "@dicebear/core": "10.6.1",
    "@dicebear/styles": "10.5.0",
    "@gravity-ui/icons": "2.21.0",
    "@heroui/react": "3.2.4",
    "@heroui/styles": "3.2.4",
    "@hookform/resolvers": "5.2.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.101.4",
    "@upstash/qstash": "2.11.3",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.4",
    "better-auth": "1.7.2",
    "clipboard-copy": "4.0.1",
    "clsx": "2.1.1",
    "debug": "4.4.3",
    "drizzle-orm": "0.45.2",
    "js-cookie": "3.0.8",
    "leaflet": "1.9.4",
    "next": "16.3.5",
    "next-intl": "4.14.0",
    "nextjs-toploader": "3.9.17",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "postcss": "8.5.26",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "6.9.5",
    "react-hook-form": "7.72.1",
    "react-qr-code": "2.2.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.2.2",
    "ua-parser-js": "2.0.10",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eloqnt/cli": "^0.6.29",
    "@react-email/ui": "^6.9.5",
    "@types/debug": "^4.1.13",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-portal": "^4.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-perfectionist": "4.15.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-perf": "3.3.3",
    "eslint-plugin-sonarjs": "4.0.3",
    "globals": "17.5.0",
    "knip": "6.32.2",
    "prettier": "3.8.3",
    "sass": "1.99.0",
    "stylelint": "16.14.1",
    "stylelint-config-standard-scss": "14.0.0",
    "stylelint-prettier": "5.0.3",
    "typescript": "^5",
    "typescript-eslint": "8.59.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
